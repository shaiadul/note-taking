PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/secure_notes_db
JWT_SECRET=super_secret_jwt_key_must_be_at_least_16_chars_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Upstash Redis configuration (Optional: Leave blank to use high-performance in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

